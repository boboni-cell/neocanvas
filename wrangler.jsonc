{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neocanvas",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-16",
  "routes": [
    {
      "pattern": "neocanvas.hanyue-room.design",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "NeoCanvasContainer",
      "image": "ghcr.io/boboni-cell/neocanvas:latest",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEOCANVAS_CONTAINER",
        "class_name": "NeoCanvasContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NeoCanvasContainer"]
    }
  ]
}
